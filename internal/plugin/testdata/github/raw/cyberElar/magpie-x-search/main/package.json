  "description": "MCP server for native Grok X search through local magpie-friday OAuth, callable by any model.",
  "license": "MIT",
  "author": "cyberElar",
  "homepage": "https://github.com/cyberElar/magpie-friday-x-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberElar/magpie-friday-x-search.git"
  },
  "bugs": {
    "url": "https://github.com/cyberElar/magpie-friday-x-search/issues"
  },
  "keywords": ["mcp", "x-search", "twitter", "grok", "magpie-friday", "oauth", "stdio"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
